{
	"name": "@danypops/pipes",
	"version": "0.18.0",
	"license": "MIT",
	"description": "Supervised Bun daemon for pi-pipes: authenticated loopback CI status/trigger/log operations across GitHub, GitLab, and Jenkins",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./cli": "./src/cli/client-exports.ts",
		"./rpc": "./src/rpc/index.ts",
		"./run": "./src/run/index.ts",
		"./sqlite": "./src/sqlite/index.ts",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": ["src", "package.json"],
	"bin": {
		"pipes": "src/cli/index.ts"
	},
	"scripts": {
		"test": "bun test",
		"check": "bun x tsc --noEmit"
	},
	"packed": {
		"daemonService": {
			"name": "pipes",
			"displayName": "Pipes CI daemon",
			"binPath": "src/cli/index.ts",
			"args": ["serve"],
			"handleFilename": "daemon.json",
			"restartOnFailure": true,
			"restartSec": 2
		}
	},
	"dependencies": {
		"@danypops/enigma-client": "^0.6.2",
		"@danypops/vehicle-client": "^0.9.1",
		"@danypops/vehicle-core": "^0.17.0",
		"@danypops/vehicle-server": "^0.24.1",
		"open": "^11.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.19.19",
		"bun-types": "latest",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/pipes.git",
		"directory": "packages/pipes"
	}
}
