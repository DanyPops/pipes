{
  "name": "pipes-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "keywords": ["pi-package"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "format": "biome format --write .",
    "lint": "biome check --write . && eslint packages --max-warnings 0",
    "lint:ci": "biome ci . && eslint packages --max-warnings 0"
  },
  "pi": {
    "extensions": ["packages/pi-pipes/src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/pipes.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@danypops/pi-tui-harness": "file:../pi-integral/packages/pi-tui-harness",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jiti": "^2.7.0",
    "typescript-eslint": "^8.65.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
